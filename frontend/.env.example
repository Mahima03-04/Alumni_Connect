# ============================================================================
# AlumniConnect - Frontend environment template
# Copy to `.env` only if you need to override the defaults.
# ============================================================================

# Base URL for the REST API.
# Leave as /api/v1 to use the Vite development proxy (recommended locally).
# Set a full URL such as http://localhost:5000/api/v1 when the API is hosted
# on a different origin.
VITE_API_BASE_URL=/api/v1
