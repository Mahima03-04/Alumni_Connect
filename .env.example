# ============================================================================
# AlumniConnect - combined environment template
#
# The project is a monorepo with two apps. Each app reads its own env file:
#
#   backend/.env    <- copy of backend/.env.example
#   frontend/.env   -> copy of frontend/.env.example
#
# This root file documents every variable in one place. Copy the relevant
# section into the matching app's .env file. NEVER commit real .env files.
# ============================================================================

# ----------------------------------------------------------------------------
# BACKEND (backend/.env)
# ----------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# Database - local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/alumniconnect
# Separate database used only by the automated test suite
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/alumniconnect_test

# Authentication - generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string_for_local_development
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=ac_token

# Cross origin + cookies
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false

# CSRF double-submit protection (true = enabled)
CSRF_ENABLED=true

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ----------------------------------------------------------------------------
# FRONTEND (frontend/.env)
# ----------------------------------------------------------------------------

# Base URL for the REST API. Leave as /api/v1 to use the Vite development
# proxy. Set a full URL (e.g. http://localhost:5000/api/v1) when hosted
# separately.
VITE_API_BASE_URL=/api/v1
