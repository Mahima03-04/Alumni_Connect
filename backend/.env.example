# ============================================================================
# AlumniConnect - Backend environment template
# Copy this file to `.env` and adjust the values for your machine.
# NEVER commit the real `.env` file.
# ============================================================================

# Server
NODE_ENV=development
PORT=5000

# Database
# Local MongoDB (default) or MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/alumniconnect

# Separate database used only by the automated test suite.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/alumniconnect_test

# Authentication
# Generate a strong secret, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string_for_local_development
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=ac_token

# Cross origin + cookies
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false

# CSRF double-submit protection.
# true  -> every state changing request must send the x-csrf-token header.
# false -> protection disabled (only acceptable for quick debugging).
CSRF_ENABLED=true

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Temporary passwords generated by the forgot-password placeholder route
# are printed to the console in development. They are never emailed locally.
