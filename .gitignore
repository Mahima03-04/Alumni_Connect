# ============================================================================
# AlumniConnect - git ignore
# ============================================================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment files (never commit real secrets)
.env
.env.*
!.env.example
!*/.env.example
!**/.env.example

# Build output
dist/
build/
frontend/dist/
*.tsbuildinfo

# Test / coverage output
coverage/
.nyc_output/
*.lcov

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Uploaded user content (keep the folder, ignore the files)
backend/uploads/*
!backend/uploads/.gitkeep

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Misc
.cache/
.temp/
.tmp/
.env
certs/